#include <iostream>
using namespace std;

int main()
{
    string name;
    int marks;
    int total = 0;
    int highest = 0;
    int lowest = 0;
    int passed = 0;
    int failed = 0;
    double average;

    for (int i = 1; i <= 5; i++)
    {
        cout << "Enter Student Name: ";
        cin >> name;

        cout << "Enter Marks: ";
        cin >> marks;

        total = total + marks;

        if (marks > highest)
        {
            highest = marks; }

        if (i == 1)
        {
            lowest = marks; }
        else if (marks < lowest)
        {
            lowest = marks;}

        if (marks >= 40)
        {
            passed++; }
        else
        {
            failed++; }
    }

    average = total / 5.0;

    cout << "\nTotal Marks = " << total << endl;
    cout << "Average Marks = " << average << endl;
    cout << "Highest Marks = " << highest << endl;
    cout << "Lowest Marks = " << lowest << endl;
    cout << "Passed Students = " << passed << endl;
    cout << "Failed Students = " << failed << endl;

    return 0;
}
